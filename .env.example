PORT=3000

# Create your own long random value. Meta uses the same value when verifying the callback URL.
VERIFY_TOKEN=

# Meta App Dashboard > App settings > Basic > App secret.
# Never commit the real secret.
META_APP_SECRET=

# Meta app ID (not secret).
META_APP_ID=

# Facebook Login for Business / WhatsApp Embedded Signup configuration ID (not the app ID).
META_CONFIG_ID=

# Keep aligned with the Graph API version configured for the Meta app.
META_GRAPH_VERSION=v26.0
